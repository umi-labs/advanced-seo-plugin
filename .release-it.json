{
  "git": {
    "requireCleanWorkingDir": true,
    "tagName": "v${version}",
    "commitMessage": "chore(release): v${version}",
    "push": true
  },
  "npm": {
    "publish": true,
    "public": true,
    "verifyAccess": false
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "assets": ["dist/**/*"],
    "draft": false
  },
  "hooks": {
    "before:bump": ["pnpm build"],
    "after:release": ["echo Release ${version} finished"]
  }
}
